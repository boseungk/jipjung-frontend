# ============================================
# 환경변수 예시 파일
# 이 파일을 복사하여 .env.local 또는 .env 로 사용하세요.
# ============================================

# 카카오맵 API 키
VITE_KAKAO_MAP_KEY=

# ============================================
# API 설정
# ============================================

# 방법 1: Vite 프록시 사용 (권장 - 개발 환경)
# vite.config.js의 proxy 설정이 /api 요청을 백엔드로 포워딩합니다.
# 이 경우 설정하지 않거나 /api 로 설정합니다.
# VITE_API_BASE_URL=/api

# 방법 2: 직접 백엔드 URL 사용 (백엔드 CORS 설정 필요)
# VITE_API_BASE_URL=http://localhost:8080/api

# 방법 3: 프로덕션 환경
# VITE_API_BASE_URL=https://api.jipjung.com/api
